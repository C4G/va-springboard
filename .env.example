# Local Postgres container
DATABASE_PW=replace-with-a-random-password
DATABASE_USER=va_springboard
DATABASE_NAME=va_springboard
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://va_springboard:replace-with-a-random-password@localhost:5432/va_springboard?schema=public

# Auth.js / Google OAuth
AUTH_SECRET=replace-with-output-from-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
RESEND_API_KEY=

# Deployment defaults
IMAGE_TAG=latest
APP_PORT=3003
BACKUP_MODE=required
BACKUP_KEEP=10
